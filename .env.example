# Server-side configuration only. Copy to .env; never add real values here.
# Gemini (required when the AI service is enabled)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional services: populate only when enabling the corresponding integration.
ELEVENLABS_API_KEY=
DATABASE_URL=
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
RUNNER_SERVICE_TOKEN=

# HPC / SSH integration (backend/hpc). Not secrets; defaults shown.
# HPC_MOCK=true fakes the remote machine (2FA, GPUs, jobs, logs, results) for demos.
HPC_MOCK=true
HPC_MOCK_2FA=true
HPC_MOCK_PENDING_SECONDS=8
HPC_MOCK_RUN_SECONDS=22
# workstation = Nittany AI Compute (background processes, shared GPUs); slurm = Roar Collab.
COMPUTE_BACKEND=workstation
# Defaults depend on COMPUTE_BACKEND (slurm: TARGET_HOST=submit.hpc.psu.edu, no jump host).
# Set JUMP_HOST= (empty) to connect directly.
JUMP_HOST=ssh.ist.psu.edu
TARGET_HOST=nittanyaicompute.ist.psu.edu
# Workstation jobs live in $BASE_DIR/<username>/<project>/; nothing outside it is touched.
BASE_DIR=/data/pre
GPU_BUSY_UTIL_PERCENT=10
GPU_BUSY_MEMORY_MB=1024
# SLURM only: project root, relative to the remote $HOME.
HPC_REMOTE_BASE_DIR=pre-projects
HPC_CONNECT_TIMEOUT=60
HPC_AUTH_TIMEOUT=180
HPC_KEEPALIVE_INTERVAL=30
HPC_STRICT_HOST_KEYS=true
HPC_KNOWN_HOSTS=
# Local dev only: lets /hpc/connect read private_key_path from this machine's disk.
HPC_ALLOW_KEY_PATHS=false
HPC_EXEC_MAX_TIMEOUT=300
HPC_ENV_TIMEOUT=1800
HPC_MAX_DOWNLOAD_MB=100
HPC_POLL_INTERVAL=5
