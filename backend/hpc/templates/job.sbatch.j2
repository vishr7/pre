#!/bin/bash
# Generated by PRE (Progressive Research Editor). Review before submitting.
#SBATCH --job-name={{ spec.job_name }}
#SBATCH --chdir={{ work_dir }}
#SBATCH --output={{ work_dir }}/slurm-{{ "%A_%a" if array_size else "%j" }}.out
#SBATCH --nodes={{ spec.nodes }}
#SBATCH --ntasks={{ spec.ntasks }}
#SBATCH --cpus-per-task={{ spec.cpus_per_task }}
#SBATCH --mem={{ spec.memory }}
#SBATCH --time={{ spec.time_limit }}
{% if spec.partition %}
#SBATCH --partition={{ spec.partition }}
{% endif %}
{% if spec.account %}
#SBATCH --account={{ spec.account }}
{% endif %}
{% if spec.gpus %}
#SBATCH --gres=gpu:{{ spec.gpus }}
{% endif %}
{% if array_size %}
#SBATCH --array=0-{{ array_size - 1 }}{% if spec.max_concurrent %}%{{ spec.max_concurrent }}{% endif %}

{% endif %}

set -eo pipefail

export PRE_JOB_DIR={{ work_dir | shquote }}
export PRE_PROJECT_DIR={{ project_dir | shquote }}
{% for name, value in spec.env.items() %}
export {{ name }}={{ value | shquote }}
{% endfor %}
{% if spec.modules %}

module purge || true
{% for module in spec.modules %}
module load {{ module }}
{% endfor %}
{% endif %}
{% if spec.conda_env %}

if command -v conda >/dev/null 2>&1; then eval "$(conda shell.bash hook)"; fi
conda activate {{ spec.conda_env }}
{% endif %}
{% if array_size %}

# Parameter sweep: task N gets the N-th value of each array below.
export PRE_TASK_ID="$SLURM_ARRAY_TASK_ID"
{% for name, values in param_values.items() %}
{{ name }}_VALUES=({% for v in values %} {{ v | shquote }}{% endfor %} )
export {{ name }}="${{ '{' }}{{ name }}_VALUES[$SLURM_ARRAY_TASK_ID]{{ '}' }}"
{% endfor %}
{% endif %}

echo "[PRE] job ${SLURM_JOB_ID:-local} started on $(hostname) at $(date)"
{{ command }}
echo "[PRE] job ${SLURM_JOB_ID:-local} finished at $(date)"
