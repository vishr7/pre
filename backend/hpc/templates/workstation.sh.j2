#!/bin/bash
# Generated by PRE (Progressive Research Editor). Review before running.
# Launched detached with `setsid nohup`; stdout/stderr go to output.log.
# PRE-JOB {{ meta_json }}
JOB_DIR={{ work_dir | shquote }}
cd "$JOB_DIR" || exit 1
echo "$$ $(date +%s)" > "$JOB_DIR/pid"

child=0
finish() {
  echo "$1 $(date +%s)" > "$JOB_DIR/exit_code"
  echo "[PRE] job finished with exit code $1 at $(date)"
  exit "$1"
}
on_signal() {
  # `timeout` runs in its own process group, so forward the signal to it explicitly.
  if [ "$child" -gt 0 ]; then kill -TERM "$child" 2>/dev/null; wait "$child"; fi
  echo "[PRE] cancelled"
  finish 143
}
trap on_signal TERM INT HUP

export PRE_JOB_DIR="$JOB_DIR"
export PRE_PROJECT_DIR={{ project_dir | shquote }}
export CUDA_VISIBLE_DEVICES={{ ("" if gpu is none else gpu|string) | shquote }}
export PYTHONUNBUFFERED=1
{% for name, value in env.items() %}
export {{ name }}={{ value | shquote }}
{% endfor %}
{% if venv_dir %}
if [ ! -f {{ (venv_dir ~ "/bin/activate") | shquote }} ]; then
  echo "[PRE] venv not found: {{ venv_dir }} (create it with POST /hpc/sessions/{id}/env)"
  finish 2
fi
source {{ (venv_dir ~ "/bin/activate") | shquote }}
{% endif %}

echo "[PRE] job {{ job_id }} started on $(hostname) at $(date) (CUDA_VISIBLE_DEVICES=$CUDA_VISIBLE_DEVICES)"
deadline=$(( $(date +%s) + {{ seconds }} ))
final=0
{% for run in runs %}

# ---- run {{ run.index + 1 }}/{{ runs|length }} ----
remaining=$(( deadline - $(date +%s) ))
if [ "$remaining" -le 0 ]; then echo "[PRE] time limit reached"; finish 124; fi
mkdir -p {{ run.dir | shquote }} && cd {{ run.dir | shquote }}
export PRE_RUN_DIR={{ run.dir | shquote }} PRE_RUN_INDEX={{ run.index }}
{% for name, value in run.params.items() %}
export {{ name }}={{ value | shquote }}
{% endfor %}
{% if sweep %}
echo "[PRE] run {{ run.index + 1 }}/{{ runs|length }}:{% for name, value in run.params.items() %} {{ name }}={{ value }}{% endfor %}"
{% endif %}
timeout --kill-after=30 "$remaining" bash -c {{ command | shquote }} &
child=$!
echo "$child" > "$JOB_DIR/child_pid"
wait "$child"; rc=$?
child=0
{% if sweep %}
echo "$rc $(date +%s)" > {{ (run.dir ~ "/exit_code") | shquote }}
echo "[PRE] run {{ run.index + 1 }} finished with exit code $rc"
{% endif %}
if [ "$rc" -eq 124 ]; then echo "[PRE] time limit reached"; finish 124; fi
if [ "$rc" -ne 0 ] && [ "$final" -eq 0 ]; then final=$rc; fi
{% endfor %}

finish "$final"
